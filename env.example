# 应用基础配置
PROJECT_NAME="My FastAPI Project"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"
VERSION="0.1.0"

# 日志
LOG_LEVEL="INFO"
LOG_JSON=false

# MySQL 连接（启用后方可使用查询接口）
MYSQL_ENABLED=false
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB="test"
MYSQL_AUTH_PLUGIN="mysql_native_password"
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=10
MYSQL_CHARSET="utf8mb4"

# 其他配置示例
# CORS_ORIGINS='["http://localhost:3000"]'

